# Installed by ops/systemd/install.sh, which fills in @USER@, @SCOUT_HOME@ and @DOCKER@.
[Unit]
Description=Scout: search WorkBC, then read the job boards
Documentation=file://@SCOUT_HOME@/code/docs/box-setup.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@SCOUT_HOME@/code
Environment=SCOUT_HOME=@SCOUT_HOME@
# A sweep takes about a minute; this only stops a hung one.
TimeoutStartSec=30min
Nice=10
ExecStart=@DOCKER@ compose --profile scout run --rm -T scout sweep
